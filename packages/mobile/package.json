{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile app created with Capacity: Expo, Expo Router, NativeWind.",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --go --port 8081",
    "ios": "expo start --go --port 8081 --ios",
    "android": "expo start --go --port 8081 --android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run"
  },
  "dependencies": {
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "nativewind": "^4.2.7",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^57.0.2",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
