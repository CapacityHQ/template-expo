{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "description": "Mobile app created with Capacity: Expo, Expo Router, NativeWind.",
  "license": "MIT",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --go --port 8081",
    "ios": "expo start --go --port 8081 --ios",
    "android": "expo start --go --port 8081 --android",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-navigation/native": "7.5.0",
    "expo": "~55.0.31",
    "expo-constants": "~55.0.17",
    "expo-font": "~55.0.8",
    "expo-haptics": "~55.0.18",
    "expo-image": "~55.0.11",
    "expo-linking": "~55.0.17",
    "expo-router": "~55.0.18",
    "expo-splash-screen": "~55.0.25",
    "expo-sqlite": "~55.0.20",
    "expo-status-bar": "~55.0.6",
    "expo-symbols": "~55.0.9",
    "expo-system-ui": "~55.0.22",
    "nativewind": "^4.2.7",
    "react": "19.2.0",
    "react-native": "0.83.10",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.2",
    "react-native-screens": "~4.23.0",
    "react-native-worklets": "0.7.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^55.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@react-navigation/native"
      ]
    }
  }
}
